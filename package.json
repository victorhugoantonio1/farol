{
  "name": "topwatch",
  "version": "0.1.0",
  "description": "Uma barrinha no topo da tela com os alertas do Zabbix, extensível por plugins.",
  "main": "main.js",
  "author": "Victor",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test",
    "dist": "electron-builder --win",
    "lab:up": "docker compose -f lab/zabbix/docker-compose.yml up -d",
    "lab:down": "docker compose -f lab/zabbix/docker-compose.yml down",
    "lab:setup": "node lab/zabbix/lab.js setup",
    "lab:scenario": "node lab/zabbix/lab.js scenario",
    "lab:status": "node lab/zabbix/lab.js status"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.victorhugoantonio1.topwatch",
    "productName": "TopWatch",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  }
}
